{
  "name": "@scormflow/client",
  "version": "0.1.0",
  "description": "Umbrella package for ScormFlow: SDK, player, React bindings, and types in a single install. Drop-in SCORM, xAPI, and cmi5 for any app.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "import": "./dist/player.js",
      "require": "./dist/player.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scormflow/scorm-engine-client.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/scormflow/scorm-engine-client/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/scormflow/scorm-engine-client/issues"
  },
  "keywords": [
    "scorm",
    "scorm-1-2",
    "scorm-2004",
    "xapi",
    "cmi5",
    "elearning",
    "lms",
    "scorm-player",
    "react"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts src/player.ts src/react.ts src/types.ts --format esm,cjs --dts --clean --sourcemap --external react --external react-dom",
    "dev": "tsup src/index.ts src/player.ts src/react.ts src/types.ts --format esm,cjs --dts --watch --external react --external react-dom",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@scormflow/player": "workspace:*",
    "@scormflow/react": "workspace:*",
    "@scormflow/sdk": "workspace:*",
    "@scormflow/types": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^19.3.0",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
